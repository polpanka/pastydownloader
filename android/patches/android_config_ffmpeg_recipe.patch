+            import shutil
+            local_ffmpeg_recipe = self.source_file.parent / "android" / "recipes" / "ffmpeg"
+            if local_ffmpeg_recipe.is_dir():
+                shutil.copytree(local_ffmpeg_recipe, recipe_dir / "ffmpeg", dirs_exist_ok=True)
+                logging.info(f"[DEPLOY] Copiata recipe locale ffmpeg in {recipe_dir / 'ffmpeg'}")
         return recipe_dir
