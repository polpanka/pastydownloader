+package org.kivy.android;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.os.IBinder;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.io.IOException;
+
+// PATCH locale (PastyDownloader): Foreground Service minimale - la sua
+// unica funzione e' tenere il processo (lo stesso di PythonActivity, non un
+// ":servizio" separato con un secondo interprete Python) esente dal freeze
+// che Android applica alle app normali pochi secondi/minuti dopo essere
+// uscite dal primo piano (vedi ANDROID_HISTORY.md - scoperto dal bug della
+// notifica di fine download in ritardo). Il vero download continua a girare
+// nel thread Python di sempre: questo servizio si limita a mostrare la
+// notifica persistente che Android richiede in cambio dell'esenzione, nel
+// frattempo tenendo vivo (per via indiretta, essendo nello stesso processo)
+// anche quel thread. Avviato/fermato da PythonActivity.pollDownloadActive(),
+// mai da se stesso - readNotificationText() legge il testo (gia' tradotto)
+// che Python scrive nello stesso file che dice a PythonActivity se avviarlo
+public class DownloadForegroundService extends Service {
+
+    private static final String CHANNEL_ID = "pastydownloader_downloading";
+    private static final String DOWNLOAD_ACTIVE_FILENAME = "download_active.txt";
+    private static final int NOTIFICATION_ID = 2;
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        ensureChannel();
+        startForeground(NOTIFICATION_ID, buildNotification());
+        return START_NOT_STICKY;
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    private void ensureChannel() {
+        if (Build.VERSION.SDK_INT < 26) return;
+        NotificationManager manager =
+                (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
+        if (manager == null) return;
+        // IMPORTANCE_LOW: niente suono/pop-up per una notifica che resta
+        // visibile a lungo per tutta la durata del download - solo la
+        // notifica di fine batch (canale separato, vedi PythonActivity)
+        // deve essere piu' evidente
+        NotificationChannel channel = new NotificationChannel(
+                CHANNEL_ID, "Downloading", NotificationManager.IMPORTANCE_LOW);
+        manager.createNotificationChannel(channel);
+    }
+
+    private Notification buildNotification() {
+        Intent openIntent = getPackageManager().getLaunchIntentForPackage(getPackageName());
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+        if (Build.VERSION.SDK_INT >= 23) flags |= PendingIntent.FLAG_IMMUTABLE;
+        PendingIntent contentIntent = PendingIntent.getActivity(this, 0, openIntent, flags);
+        Notification.Builder builder = (Build.VERSION.SDK_INT >= 26)
+                ? new Notification.Builder(this, CHANNEL_ID)
+                : new Notification.Builder(this);
+        builder.setContentTitle(getApplicationInfo().loadLabel(getPackageManager()).toString())
+               .setContentText(readNotificationText())
+               .setSmallIcon(android.R.drawable.stat_sys_download)
+               .setOngoing(true)
+               .setContentIntent(contentIntent);
+        return builder.build();
+    }
+
+    private String readNotificationText() {
+        File flag = new File(getFilesDir(), DOWNLOAD_ACTIVE_FILENAME);
+        if (!flag.exists()) return "";
+        try (BufferedReader reader = new BufferedReader(new FileReader(flag))) {
+            String line = reader.readLine();
+            return line != null ? line : "";
+        } catch (IOException e) {
+            return "";
+        }
+    }
+}
