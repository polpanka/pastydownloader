+    private void pollOpenFileRequest() {
+        File request = new File(getFilesDir(), OPEN_FILE_REQUEST_FILENAME);
+        if (!request.exists()) return;
+        String path;
+        try (BufferedReader reader = new BufferedReader(new FileReader(request))) {
+            path = reader.readLine();
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to read open file request", e);
+            request.delete();
+            return;
+        }
+        request.delete();
+        if (path == null || path.isEmpty()) return;
+        File target = new File(path);
+        if (!target.exists()) return;
+        try {
+            Uri uri = FileProvider.getUriForFile(this, getPackageName() + ".fileprovider", target);
+            Intent viewIntent = new Intent(Intent.ACTION_VIEW);
+            viewIntent.setDataAndType(uri, guessMimeType(path));
+            viewIntent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            startActivity(viewIntent);
+        } catch (Exception e) {
+            Log.e(TAG, "Unable to open file " + path, e);
+        }
+    }
+
+    private String guessMimeType(String path) {
+        int dot = path.lastIndexOf('.');
+        if (dot < 0 || dot == path.length() - 1) return "*/*";
+        String mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(path.substring(dot + 1).toLowerCase());
+        return mime != null ? mime : "*/*";
+    }
