+    // PATCH locale (PastyDownloader, vedi ANDROID.md): il bootstrap qt di
+    // python-for-android non richiede mai a runtime i permessi "dangerous"
+    // dichiarati in AndroidManifest.xml (a differenza del vecchio meccanismo
+    // SDL2/webview) - il modulo Python android.permissions esisterebbe, ma
+    // e' costruito sopra pyjnius, che qui non funziona (manca il simbolo
+    // nativo WebView_AndroidGetJNIEnv, presente solo nei bootstrap Kivy
+    // webview/service_only). Legge i permessi dichiarati nel manifest e
+    // chiede quelli "dangerous" non ancora concessi, una volta sola
+    // all'avvio - e' l'unico punto dell'app dove serve toccare Java
+    private void requestNeededPermissions() {
+        if (android.os.Build.VERSION.SDK_INT < 23) return;
+        try {
+            String[] declared = getPackageManager()
+                    .getPackageInfo(getPackageName(), PackageManager.GET_PERMISSIONS)
+                    .requestedPermissions;
+            if (declared == null) return;
+            List<String> toRequest = new ArrayList<String>();
+            for (String perm : declared) {
+                if (checkSelfPermission(perm) == PackageManager.PERMISSION_GRANTED) continue;
+                try {
+                    android.content.pm.PermissionInfo info = getPackageManager().getPermissionInfo(perm, 0);
+                    int protection = info.protectionLevel & android.content.pm.PermissionInfo.PROTECTION_MASK_BASE;
+                    if (protection == android.content.pm.PermissionInfo.PROTECTION_DANGEROUS) {
+                        toRequest.add(perm);
+                    }
+                } catch (PackageManager.NameNotFoundException e) {
+                    // permesso non riconosciuto dal sistema, salta
+                }
+            }
+            if (!toRequest.isEmpty()) {
+                requestPermissions(toRequest.toArray(new String[0]), 1);
+            }
+        } catch (PackageManager.NameNotFoundException e) {
+            Log.e(TAG, "Unable to read declared permissions", e);
+        }
+    }
+
