+    private void handleIncomingIntent(Intent intent) {
+        if (intent == null || !Intent.ACTION_SEND.equals(intent.getAction())) return;
+        String type = intent.getType();
+        if (type == null || !type.startsWith("text/")) return;
+        String sharedText = intent.getStringExtra(Intent.EXTRA_TEXT);
+        if (sharedText == null || sharedText.trim().isEmpty()) return;
+        File inbox = new File(getFilesDir(), SHARE_INBOX_FILENAME);
+        try (FileWriter writer = new FileWriter(inbox, true)) {
+            writer.write(sharedText.trim() + "\n");
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to write share inbox", e);
+        }
+    }
+
+    private void ensureNotificationChannel() {
+        if (android.os.Build.VERSION.SDK_INT < 26) return;
+        NotificationManager manager =
+                (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
+        if (manager == null) return;
+        NotificationChannel channel = new NotificationChannel(
+                NOTIFY_CHANNEL_ID, "Downloads", NotificationManager.IMPORTANCE_DEFAULT);
+        manager.createNotificationChannel(channel);
+    }
+
+    private void pollNotifyOutbox() {
+        File outbox = new File(getFilesDir(), NOTIFY_OUTBOX_FILENAME);
+        if (!outbox.exists()) return;
+        StringBuilder text = new StringBuilder();
+        try (BufferedReader reader = new BufferedReader(new FileReader(outbox))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (text.length() > 0) text.append("\n");
+                text.append(line);
+            }
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to read notify outbox", e);
+            return;
+        }
+        outbox.delete();
+        if (text.length() > 0) showDownloadNotification(text.toString());
+    }
+
+    private void showDownloadNotification(String text) {
+        NotificationManager manager =
+                (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
+        if (manager == null) return;
+        Intent openIntent = getPackageManager().getLaunchIntentForPackage(getPackageName());
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+        if (android.os.Build.VERSION.SDK_INT >= 23) flags |= PendingIntent.FLAG_IMMUTABLE;
+        PendingIntent contentIntent = PendingIntent.getActivity(this, 0, openIntent, flags);
+        Notification.Builder builder = (android.os.Build.VERSION.SDK_INT >= 26)
+                ? new Notification.Builder(this, NOTIFY_CHANNEL_ID)
+                : new Notification.Builder(this);
+        builder.setContentTitle(getApplicationInfo().loadLabel(getPackageManager()).toString())
+               .setContentText(text)
+               .setSmallIcon(android.R.drawable.stat_sys_download_done)
+               .setAutoCancel(true)
+               .setContentIntent(contentIntent);
+        manager.notify(1, builder.build());
+    }
