--- a/PySide6/scripts/deploy_lib/android/buildozer.py
+++ b/PySide6/scripts/deploy_lib/android/buildozer.py
@@ -38,7 +38,27 @@
         include_exts = f"{include_exts},qml,js"
         self.set_value("app", "source.include_exts", include_exts, raise_warning=False)
 
-        self.set_value("app", "requirements", "python3,shiboken6,PySide6")
+        # PATCH locale: fissa la recipe python3 a 3.14.2, la versione di cui le
+        # wheel PySide6/Shiboken6 6.12 (cp310-abi3) cercano la libpython
+        # (NEEDED libpython3.14.so): una versione diversa causa
+        # "libpython3.14.so not found" a runtime. Va tenuta allineata alla
+        # recipe python3 del commit p4a pinnato nel workflow (vedi ANDROID.md)
+        # PATCH locale: motore di download generico (requests, vedi
+        # Tools.downloadAsyncGeneric/downloadNotAsyncGeneric in libs.py) -
+        # pure Python, niente aiohttp: la sua recipe p4a (3.8.3) non compila
+        # con CPython 3.14. A differenza di psutil non serve una recipe
+        # certifi: bundle CA per SSL_CERT_FILE (vedi main.py e ANDROID.md) -
+        # senza, ogni richiesta HTTPS fallisce con SSLCertVerificationError
+        # ffmpeg: recipe ufficiale p4a, compila il binario CLI e lo rinomina
+        # in libffmpegbin.so (stesso trucco gia' usato da p4a per
+        # libpythonbin.so, per aggirare il divieto W^X di eseguire binari
+        # scritti a runtime, vedi android/recipes/ffmpeg/).
+        # La recipe dichiara depends = [('sdl2','sdl3')] (retaggio Kivy): da
+        # verificare se la build lo tollera col bootstrap qt o se serve un
+        # override locale in deployment/recipes (p4a.local_recipes)
+        self.set_value("app", "requirements",
+                       "python3==3.14.2,hostpython3==3.14.2,shiboken6,PySide6,"
+                       "requests,certifi,ffmpeg")
 
         # android platform specific
         if pysidedeploy_config.ndk_path:
@@ -74,11 +94,40 @@
         self.set_value("app", "p4a.branch", P4A_BRANCH)
         self.set_value("app", "p4a.commit", P4A_COMMIT)
 
+        # PATCH locale: checkout persistente di python-for-android (branch
+        # develop, patchato a mano - vedi PythonActivity.java li' dentro e
+        # ANDROID.md) invece del clone-and-purge di default del tool a ogni
+        # build, altrimenti la patch andrebbe perduta a ogni run
+        self.set_value("app", "p4a.source_dir",
+                       str(Path.home() / ".pyside6_android_deploy" / "python-for-android"))
+
         # add permissions
         permissions = self.__find_permissions(pysidedeploy_config.dependency_files)
+        # PATCH locale: WRITE/READ_EXTERNAL_STORAGE per scrivere nella
+        # cartella Download pubblica (vedi ANDROID.md e android.api sotto) -
+        # non derivano dalle dependency XML del wheel PySide6, vanno aggiunte
+        # a mano
+        permissions.add("android.permission.WRITE_EXTERNAL_STORAGE")
+        permissions.add("android.permission.READ_EXTERNAL_STORAGE")
         permissions = ", ".join(permissions)
         self.set_value("app", "android.permissions", permissions)
 
+        # PATCH locale: targetSdk abbassato a 28 per ottenere storage
+        # "legacy" (scrittura diretta in /storage/emulated/0/Download senza
+        # MediaStore/JNI, indipendentemente dalla versione Android reale del
+        # device) - tentativo prima del patch pyjnius, vedi ANDROID.md
+        self.set_value("app", "android.api", "28")
+
+        # PATCH locale: senza questo, buildozer usa il suo default
+        # "orientation = portrait" (vedi default.spec del pacchetto
+        # buildozer) - l'Activity risulta bloccata in verticale e il
+        # telefono ruotato non genera nessun resize/layout, indipendentemente
+        # dal fatto che la UI Qt (basata su QVBoxLayout/QHBoxLayout, non su
+        # coordinate fisse) si adatterebbe gia' da sola. "unspecified" lascia
+        # decidere al sistema/all'utente (rotazione automatica), come una
+        # normale app
+        self.set_value("app", "android.manifest.orientation", "unspecified")
+
         # add jars and initClasses for the jars
         jars, init_classes = self.__find_jars(pysidedeploy_config.dependency_files,
                                               pysidedeploy_config.jars_dir)
