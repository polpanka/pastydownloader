+    private static final String INCOMING_URL_FILENAME = "incoming_url.txt";
+
+    private void handleDeepLinkIntent(Intent intent) {
+        if (intent == null || !Intent.ACTION_VIEW.equals(intent.getAction())) return;
+        Uri data = intent.getData();
+        if (data == null) return;
+        File tmp = new File(getFilesDir(), INCOMING_URL_FILENAME + ".tmp");
+        try (FileWriter writer = new FileWriter(tmp)) {
+            writer.write(data.toString());
+        } catch (IOException e) {
+            Log.e(TAG, "Unable to write incoming url", e);
+            return;
+        }
+        if (!tmp.renameTo(new File(getFilesDir(), INCOMING_URL_FILENAME))) tmp.delete();
+    }
